# Email Configuration (using Nodemailer)
# SMTP server settings - works with Gmail, Outlook, custom SMTP servers, etc.

# SMTP Host (e.g., smtp.gmail.com for Gmail, smtp-mail.outlook.com for Outlook)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use secure connection (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email address to send from (usually same as SMTP_USER)
SMTP_FROM_EMAIL=your-email@gmail.com

# Email address to receive contact form submissions
CONTACT_EMAIL=your-email@gmail.com
